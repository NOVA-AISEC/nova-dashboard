# Frontend build-time data source switch.
# Default behavior when unset is mock mode because src/api/index.ts
# only uses the HTTP client when this is exactly "false".
VITE_USE_MOCK=true

# Optional stakeholder gate for hosted demos.
# This build-time value is visible to clients; it is not authentication.
VITE_DEMO_PASSWORD=

# Local Express API port used by:
# - server/index.js
# - vite.config.ts dev proxy
DAMA_API_PORT=8787

# HTTP mode requires server-side accounts. Provision with npm run auth:add-user.
# Relative to the project root; never prefix secret settings with VITE_.
DAMA_AUTH_USERS_FILE=.secrets/users.json
DAMA_SESSION_HOURS=8
# Comma-separated exact web/API origins. Local defaults include ports 5173 and 5175.
# Production requires explicit HTTPS origins and a TLS reverse proxy.
# DAMA_ALLOWED_ORIGINS=https://nova.example.com
# Optional database path; only one server process may own this JSON file.
# DAMA_DB_FILE=server/data/db.json

# Local simulator controls for server/ only.
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=8000
